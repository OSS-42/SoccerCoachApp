# Copy to .env.ota.local (gitignored). Used by scripts/ota-publish.mjs
#
# Use ~/.ssh/id_ed25519_ota (not DOragoug, not GitHub keys).

OTA_DEPLOY_SSH=deploy@YOUR_DROPLET_IP
OTA_DEPLOY_REMOTE_DIR=/var/www/ota/sca/live
OTA_DEPLOY_BASE_URL=https://cdn-studiophoenix.net/sca/live
OTA_DEPLOY_SSH_PORT=22
OTA_DEPLOY_SSH_KEY=$HOME/.ssh/id_ed25519_ota
OTA_DEPLOY_APK_REMOTE_DIR=/var/www/ota/sca/apk
OTA_DEPLOY_APK_BASE_URL=https://cdn-studiophoenix.net/sca/apk
